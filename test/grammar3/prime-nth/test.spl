extern def print_int(n);

def is_prime(n) {
    if (n < 2) {
        return 0;
    }
    var d = 2;
    while (d * d < n) {
        d = d + 1;
    }
    if (d * d == n) {
        return 1;
    }
    return 0;
}

def nth_prime(k) {
    var count = 0;
    var cand = 1;
    while (count < k) {
        cand = cand + 1;
        if (is_prime(cand)) {
            count = count + 1;
        }
    }
    return cand;
}

def main() {
    var n = 40;
    var p = nth_prime(n);
    print_int(p);
    return 0;
}